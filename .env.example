# Production configuration for PPT Generator
# Copy this file to .env and update with your values

# Flask Configuration
FLASK_APP=main.py
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database Configuration
# For local development (SQLite)
DATABASE_URL=sqlite:///pptgen.db

# For production (PostgreSQL on Vercel/Heroku)
# DATABASE_URL=postgresql://username:password@host:port/database

# Admin Dashboard Credentials (CHANGE THESE!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Remote MCP Configuration
# The /mcp endpoint currently has no user authentication or OAuth flow.
# Select "No authentication" when connecting it to ChatGPT. OAuth discovery URLs return 404.
# Set this to the public HTTPS base URL when running behind a proxy or on a hosting platform.
# MCP download links use the incoming request host when this is unset.
# PUBLIC_BASE_URL=https://ppt.example.com

# Optional comma-separated browser origins allowed to call /mcp.
# ChatGPT and Claude web origins, localhost, and the app's existing origin are allowed by default.
# MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai

# Gunicorn Configuration
WORKERS=4
TIMEOUT=120
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes

# Logging
LOG_LEVEL=INFO
