#!/usr/bin/env bash
# PPT Generator CLI
# Cross-platform launcher for Linux and macOS

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Detect OS
OS="$(uname -s)"
case "${OS}" in
    Linux*)     MACHINE=Linux;;
    Darwin*)    MACHINE=Mac;;
    *)          
        echo "❌ Error: Unsupported OS. For Windows use launchers/pptgen.bat or launchers/pptgen.ps1"
        exit 1
        ;;
esac

# Prefer a project-local environment, then use the installer-managed environment.
VENV_DIR="$INSTALL_DIR/.venv"
if [ ! -d "$VENV_DIR" ] && [ -d "$HOME/.ppt-generator/.venv" ]; then
    VENV_DIR="$HOME/.ppt-generator/.venv"
fi

if [ ! -d "$VENV_DIR" ]; then
    echo "❌ Error: Virtual environment not found."
    echo "Please run the installer first:"
    echo "  ./installers/install.sh"
    exit 1
fi

cd "$INSTALL_DIR"

# Parse arguments
PRODUCTION=0
PORT=5000

while getopts "p::h" opt; do
    case $opt in
        p)
            PRODUCTION=1
            if [ ! -z "$OPTARG" ]; then
                PORT=$OPTARG
            fi
            ;;
        h)
            echo "PPT Generator CLI"
            echo ""
            echo "Usage: ./launchers/pptgen [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  -p [port]    Run in production mode with Gunicorn (default port: 5000)"
            echo "  -h           Show this help message"
            echo ""
            echo "Examples:"
            echo "  ./launchers/pptgen              # Run development server"
            echo "  ./launchers/pptgen -p           # Run production server on port 5000"
            echo "  ./launchers/pptgen -p 8000      # Run production server on port 8000"
            exit 0
            ;;
        \?)
            echo "Invalid option: -$OPTARG" >&2
            exit 1
            ;;
    esac
done

# Start the server
if [ $PRODUCTION -eq 1 ]; then
    echo "🚀 Starting PPT Generator in production mode on port $PORT..."
    echo "📖 Access the application at: http://localhost:$PORT"
    "$VENV_DIR/bin/python" -m gunicorn -w 4 -b 0.0.0.0:$PORT main:app
else
    echo "🚀 Starting PPT Generator in development mode..."
    echo "📖 Access the application at: http://localhost:5000"
    export FLASK_APP=main.py
    export FLASK_ENV=development
    "$VENV_DIR/bin/python" main.py
fi
